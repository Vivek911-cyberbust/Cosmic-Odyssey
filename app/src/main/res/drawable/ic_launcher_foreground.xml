<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing engine thruster plume -->
    <path android:pathData="M54,78 L47,84 L54,101 L61,84 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="78"
                android:endX="54"
                android:endY="101"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFEE58" />
                <item android:offset="0.5" android:color="#FFFF5722" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Spaceship chassis -->
    <path
        android:pathData="M54,23 L28,73 L45,68 L54,78 L63,68 L80,73 Z"
        android:fillType="nonZero">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="23"
                android:endX="54"
                android:endY="78"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00E5FF" />
                <item android:offset="1.0" android:color="#FF2979FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Neon Wings outline highlight -->
    <path
        android:pathData="M54,23 L28,73 L45,68 L54,78 L63,68 L80,73 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#FFC107"
        android:fillColor="#00000000" />

    <!-- Visor Cockpit shield -->
    <path
        android:pathData="M54,34 L48,50 M54,34 L60,50 M48,50 L54,58 L60,50 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- Spark wingtip laser emissions -->
    <path
        android:pathData="M28,73 L28,63"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeColor="#FF00E5FF" />
    <path
        android:pathData="M80,73 L80,63"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeColor="#FF00E5FF" />

</vector>
